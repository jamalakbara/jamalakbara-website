                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "hKCLW",
                      "name": "Preserve form values",
                      "fill": "$folder-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Keep name, email and project text editable during the wait. Do not clear the message, navigate away or mislabel the request as sent.",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "anzpj",
                      "name": "Accessible countdown",
                      "fill": "$folder-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Announce the rate limit once. Update the visible timer without announcing every second. Announce when sending is available again.",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Irot1",
                      "name": "Manual retry only",
                      "fill": "$folder-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "At zero, restore the normal Send message button. Keep the data intact and wait for the user to submit again. Direct email remains available throughout.",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
