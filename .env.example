# Development Environment Variables
# Copy this file to .env.local and modify as needed

# Formspree Configuration
# Get your form endpoint from: https://formspree.io/
# Create a new form and replace the ID below
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID_HERE

# Site Configuration
# Update this for your production domain
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Google Analytics Configuration
# Get your Measurement ID from Google Analytics 4 Admin > Data Streams
# Go to analytics.google.com > Admin > Data Streams > Web Stream
# Look for "Measurement ID" (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console Verification
# Add your Google Search Console verification meta tag content
# Go to search.google.com/search-console > Add Property > URL prefix
# Choose HTML tag verification and copy the content value
NEXT_PUBLIC_GSC_VERIFICATION_CONTENT=ABcDefGhiJklMnoPqrStuVwXyZ1234567890

# Environment Configuration
# Development: use "development"
# Production: use "production" (analytics will only track in production)
NEXT_PUBLIC_NODE_ENV=development

# ── Admin CMS (/admin) ─────────────────────────────────────────
# Auth.js (next-auth v5). Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
# GitHub OAuth app (one per environment — callback URL:
# <origin>/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# The only GitHub account allowed into /admin
ADMIN_GITHUB_LOGIN=jamalakbara

# Git-backed content writes (production commits via GitHub API).
# Fine-grained PAT scoped to this repo, Contents: Read & Write.
GITHUB_TOKEN=
GITHUB_REPO=jamalakbara/jamalakbara-website
GITHUB_CONTENT_BRANCH=main
# Optional override for the admin write backend: "fs" | "github".
# Default: "github" on Vercel, "fs" locally.
# ADMIN_CONTENT_BACKEND=fs

# Cloudinary Admin/Upload API (server-only — never NEXT_PUBLIC)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=